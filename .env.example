# Use 127.0.0.1, not localhost, throughout this file — see the LLM section
# below for why (same reasoning applies to every host here).

# ── Postgres ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://xposure:xposure@127.0.0.1:5442/xposure

# ── Qdrant ────────────────────────────────────────────────────────────────
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6343
QDRANT_COLLECTION=xposure_regulations

# ── Embeddings ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── LLM ───────────────────────────────────────────────────────────────────
# The default is fully local: Ollama on this machine, no cloud LLM calls, so
# no regulation or company data leaves the facility. Your own .env can point
# LLM_BASE_URL at a cloud OpenAI-compatible endpoint instead (useful on a
# machine that cannot run larger models locally); that is a local override,
# not the shipped default.
# Use 127.0.0.1, not localhost: on Windows, resolving "localhost" can add a
# slow or failed IPv6 attempt before falling back to IPv4.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma-4-31b-it

# Cloud override (uncomment and fill in to run candidate models through
# OpenRouter instead of locally):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-oss-20b   # or qwen/qwen3.6-27b | qwen/qwen3.6-35b-a3b | google/gemma-4-31b-it

# ── App ───────────────────────────────────────────────────────────────────
CORPUS_VERSION=2026-09

# ── Outbound webhook (M8, optional integration stub) ──────────────────────
# Empty by default: the agent loop sends change.detected/impact.computed and
# the API sends action.approved ONLY when WEBHOOK_URL is set — never a hard
# dependency (see app/webhooks.py). For a local demo receiver, run the app
# itself and point this at its own POST /webhooks/receiver.
# WEBHOOK_URL=http://127.0.0.1:8010/webhooks/receiver
# WEBHOOK_SECRET=change-me

# ── Frontend -> backend proxy ────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8010
PORT=3010

# -- Optional demo ERP: Odoo 17 (docker compose --profile odoo up -d) ------
# Local demo only, bound to 127.0.0.1. Empty ODOO_PASSWORD means "ERP not
# configured": /erp/status says so honestly and delegating through Odoo is
# refused with a clear message. Generate your own values; never commit real
# secrets. Remove everything with: docker compose --profile odoo down -v
ODOO_URL=http://127.0.0.1:8069
ODOO_PUBLIC_URL=http://127.0.0.1:8069
ODOO_DB=xposure_erp
ODOO_USER=admin
ODOO_PASSWORD=change-me-generate-a-local-password
ODOO_DB_PASSWORD=change-me-generate-a-local-password
# Base URL of the Xposure web app, used for the deep link written into Odoo tasks.
XPOSURE_PUBLIC_URL=http://127.0.0.1:3010
